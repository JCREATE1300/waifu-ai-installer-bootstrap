{
  "name": "waifu-ai-installer-bootstrap",
  "version": "1.0.0",
  "description": "Bootstrap installer for the Waifu AI desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron": "^31.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.jcreate1300.waifuai.bootstrap",
    "productName": "Waifu AI Bootstrap",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "waifu-ai-installer-bootstrap-${version}.exe",
      "requestedExecutionLevel": "asInvoker"
    }
  }
}